FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY pipeline ./pipeline
COPY db ./db
RUN addgroup --system --gid 10001 appgroup && adduser --system --uid 10001 --ingroup appgroup app
RUN chown -R app:appgroup /app
USER app
ENTRYPOINT ["python", "-m", "pipeline.worker.main"]